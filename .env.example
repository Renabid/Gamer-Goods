# Gamer Goods - Supabase Environment Variables
# NEVER expose the SUPABASE_SERVICE_ROLE_KEY to the client/browser!

# Public Supabase credentials (safe for client-side use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only Supabase Service Role Key (Admin operations only - never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Configuration
NEXT_PUBLIC_SITE_NAME="Gamer Goods"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
